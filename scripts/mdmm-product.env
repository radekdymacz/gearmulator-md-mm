# The Machinedrum and Monomachine Editors' names: the one place they are set.
#
# Read by the build (source/elektron/md/mdJucePlugin/mdmmPlugins.cmake: the bundle and executable
# names, the plug-in name a DAW shows, the window titles, the vendor) and sourced by the packaging,
# signing and test scripts (scripts/macos/*.sh, scripts/windows/*.ps1, scripts/mdmm-*.sh).
# Plain KEY="value" lines only: sh, CMake and PowerShell all parse them.
#
# Changing a name here renames every bundle, executable and installer page. It does not move
# anything a user already has: the data and ROM folders (~/Documents/Gearmulator Preview/<machine>),
# the settings files and the plug-in codes (AU Tmdr/Tmno, the VST3 class IDs) are fixed elsewhere and
# stay, so old DAW projects still load. The site (site/public) and the docs are text: update them too
# (scripts/check_mdmm_names.sh finds the old names).

MDMM_PRODUCT_NAME_MD="Machinedrum Editor"
MDMM_PRODUCT_NAME_MM="Monomachine Editor"

# The maker a DAW shows (AU "Future Native Audio: Machinedrum Editor", the VST3 vendor, the Windows file details).
MDMM_VENDOR="Future Native Audio"
MDMM_WEBSITE="https://mdmm.dev"

# The bundle names up to 0.3.1. The installers remove the old bundles they put in place, so a DAW
# does not list the editor twice after an upgrade.
MDMM_LEGACY_NAME_MD="Gearmulator MD"
MDMM_LEGACY_NAME_MM="Gearmulator MM"
