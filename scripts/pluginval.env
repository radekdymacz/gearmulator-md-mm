# The pluginval (Tracktion) release the editors are validated with: the one place the version and the checksums
# are set. Read by scripts/ci/mdmm_pluginval.sh (CI, all three systems, and the local wrapper
# scripts/mdmm-pluginval.sh). Plain KEY="value" lines only. To update: take the three zips of the new release,
# `shasum -a 256` them, change all four lines together.
PLUGINVAL_VERSION="1.0.4"
PLUGINVAL_SHA256_MACOS="3c4c533bda0c5059eea3ddaea752d757ee2025041f0f47e6bcb0e87f6082b29f"
PLUGINVAL_SHA256_LINUX="c01c49d8063965c4c2dea8324468336768f5c9139e0b1caebde14c2400b55352"
PLUGINVAL_SHA256_WINDOWS="c08e61ce3b96db41636f8ec7e76f4c7e2c13ebdac7fa1b5a1f52b4f32ec715ab"
