# ctest driver for mmConvertTest.js: contract JSON from the dumps, then the page round trip.
#   cmake -DTOOL=<mmDataCorpusTest> -DNODE=<node> -DSKIN=<skins/mmStudio> -DOUT=<dir> -DCORPUS="<dir;dir>" -P mmConvertTest.cmake
set(dirs)
set(n 0)
foreach(corpus IN LISTS CORPUS)
	set(json "${OUT}/json${n}")
	file(REMOVE_RECURSE "${json}")
	file(MAKE_DIRECTORY "${json}")
	execute_process(COMMAND "${TOOL}" --json "${json}" "${corpus}" RESULT_VARIABLE rc OUTPUT_QUIET)
	if(NOT rc EQUAL 0)
		message(FATAL_ERROR "mmDataCorpusTest failed on ${corpus}")
	endif()
	list(APPEND dirs "${json}")
	math(EXPR n "${n} + 1")
endforeach()
execute_process(COMMAND "${NODE}" "${SKIN}/mmConvertTest.js" ${dirs} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
	message(FATAL_ERROR "mmConvertTest failed")
endif()
