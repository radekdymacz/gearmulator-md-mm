{
  // Landing page for the Machinedrum Editor + Monomachine Editor.
  // Assets-only Worker (DOMAINS.md rule 5): no `main`, everything is served from ./public.
  // Deploy is always_human (DOMAINS.md rule 6):
  //   cd site && CLOUDFLARE_ACCOUNT_ID=331224f43e4f448483cad2f1185ea965 npx wrangler deploy
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mdmm-site",
  "compatibility_date": "2026-09-01",
  "account_id": "331224f43e4f448483cad2f1185ea965",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mdmm.nativekloud.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
